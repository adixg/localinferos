#!/bin/sh

export PATH=/bin:/usr/bin:/sbin
export HOME=/root
export TERM=linux

# 1. Essential kernel filesystems
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp

# 2. Storage drivers (uas loads usb-storage itself)
modprobe xhci-pci
modprobe ahci
modprobe uas

# 3. Mount LIO_DATA. USB sticks take a few seconds to appear after their
# driver loads, so retry for up to 10 seconds.
echo "Looking for LIO_DATA..."
i=0
until DATA=$(findfs LABEL=LIO_DATA 2>/dev/null); do
    i=$((i + 1))
    if [ "$i" -ge 10 ]; then
        echo "ERROR: no partition labelled LIO_DATA"
        exec /bin/sh
    fi
    sleep 1
done

if ! mount -t ext4 "$DATA" /data; then
    echo "ERROR: could not mount $DATA"
    exec /bin/sh
fi
mkdir -p /data/models /data/config /data/hf-cache

# 4. Network, for model downloads. Everything else works without it.
modprobe e1000
ip link set lo up
ip link set eth0 up 2>/dev/null && udhcpc -i eth0 -s /etc/udhcpc.script -n -q

# 5. Rust TUI. It starts llama-server itself; these are for the server.
export LLAMA_CACHE=/data/hf-cache
# OpenSSL looks for CA certificates under /usr/lib/ssl, which the image lacks
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

clear
# init is PID 1 and must never exit, so restart the TUI if it quits
while true; do
    /usr/bin/localinferos < /dev/tty1 > /dev/tty1 2>&1
    echo "LocalInferOS exited. Press Enter to restart."
    read -r _
done
